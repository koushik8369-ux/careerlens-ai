# CareerLens AI - Backend Environment Variables Example

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/careerlens_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Security / JWT (Placeholders for future setup)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION=86400000

# Browser origins allowed to call the backend. Use explicit comma-separated origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI Provider Configuration
# Deterministic mode is the default and requires no LLM credentials.
AI_PROVIDER=deterministic

# Set AI_PROVIDER=llm only when all of these values are available.
# The endpoint must expose an OpenAI-compatible /chat/completions route.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30s
